# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/mentiq

# Set to "false" only when serving over plain HTTP outside production
# COOKIE_SECURE=true

# Optional AI layer — leave unset to use the deterministic fallbacks
# AI_PROVIDER=openai        # openai | anthropic
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=
